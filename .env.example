# ---------------------------------------------------------------------------
# Semua variable di bawah ini OPSIONAL. Salin file ini menjadi `.env.local`
# bila ingin menimpa default.
# ---------------------------------------------------------------------------

# Domain produksi (dipakai untuk URL canonical & Open Graph).
NEXT_PUBLIC_SITE_URL=https://klinik-finamedika.vercel.app

# Base path — HANYA bila di-hosting di subfolder (mis. GitHub Pages).
# Contoh: repo "klinik-fina-medika" → NEXT_PUBLIC_BASE_PATH=/klinik-fina-medika
# NEXT_PUBLIC_BASE_PATH=

# Set "true" untuk static export (output: folder out/) — GitHub Pages / hosting statik.
# NEXT_EXPORT=true
